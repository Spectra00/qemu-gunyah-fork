
{ 'include': 'sockets.json' }

{ 'struct': 'ChardevCommon',
  'data': { '*logfile': 'str',
            '*logappend': 'bool' } }

{ 'struct': 'ChardevMux',
  'data': { 'chardev': 'str' },
  'base': 'ChardevCommon' }

{ 'struct': 'ChardevStdio',
  'data': { '*signal': 'bool' },
  'base': 'ChardevCommon' }

{ 'struct': 'ChardevSocket',
  'data': { 'addr': 'SocketAddressLegacy',
            '*server': 'bool',
            '*wait': 'bool' },
  'base': 'ChardevCommon' }

{ 'enum': 'ChardevBackendKind',
  'data': [ 'null',
            'socket',
            'mux',
            'stdio' ] }

{ 'struct': 'ChardevCommonWrapper',
  'data': { 'data': 'ChardevCommon' } }

{ 'struct': 'ChardevSocketWrapper',
  'data': { 'data': 'ChardevSocket' } }

{ 'struct': 'ChardevMuxWrapper',
  'data': { 'data': 'ChardevMux' } }

{ 'struct': 'ChardevStdioWrapper',
  'data': { 'data': 'ChardevStdio' } }

{ 'union': 'ChardevBackend',
  'base': { 'type': 'ChardevBackendKind' },
  'discriminator': 'type',
  'data': { 'null': 'ChardevCommonWrapper',
            'socket': 'ChardevSocketWrapper',
            'mux': 'ChardevMuxWrapper',
            'stdio': 'ChardevStdioWrapper' } }
